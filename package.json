{
  "name": "aio-youtube-downloader",
  "version": "1.0.0",
  "description": "Ultra-fast Native YouTube Downloader Desktop App with 4K/1080p FFmpeg Stream Muxing without yt-dlp",
  "main": "main.js",
  "scripts": {
    "start": "node src/server/appServer.js",
    "app": "electron .",
    "pack": "electron-packager . aio-youtube-downloader --platform=win32 --arch=x64 --out=release-builds --overwrite --asar",
    "dist": "electron-builder --win",
    "neu": "npx @neutralinojs/neu run",
    "build:neu": "npx @neutralinojs/neu build"
  },
  "build": {
    "appId": "com.antigravity.aioyoutubedownloader",
    "productName": "AIO YouTube Downloader",
    "directories": {
      "output": "release-installer"
    },
    "files": [
      "main.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "youtube",
    "youtube-downloader",
    "ffmpeg",
    "material-v3",
    "electron",
    "fast-downloader"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@neutralinojs/lib": "^5.3.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mime-types": "^2.1.35",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-packager": "^17.1.2"
  }
}
